#include <winver.h>
1 ICON "aura.ico"
1 24 "aura.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Free software project (GPL-3.0)"
      VALUE "FileDescription", "Aura: WiZ light control"
      VALUE "FileVersion", "1.0"
      VALUE "InternalName", "Aura"
      VALUE "LegalCopyright", "GPL-3.0. Based on kek's WiZ Light Controller (Eshaan Pisal)."
      VALUE "OriginalFilename", "Aura.exe"
      VALUE "ProductName", "Aura"
      VALUE "ProductVersion", "1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
